{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    // "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"]
}
